# Copiază acest fișier ca ".env" și completează parola ta de PostgreSQL.
# Fișierul .env NU se urcă pe GitHub (este în .gitignore).
DATABASE_URL=postgresql+psycopg://postgres:PAROLA_TA@localhost:5433/db_campus_sports

# Opțional: baza de date folosită doar de teste (trebuie să se termine cu _test).
# Dacă lipsește, se folosește numele din DATABASE_URL + "_test".
# TEST_DATABASE_URL=postgresql+psycopg://postgres:PAROLA_TA@localhost:5433/db_campus_sports_test

# Cheia cu care se semnează JWT-urile. OBLIGATORIE, minim 32 de caractere, secretă.
# Generează una cu:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (valoarea de mai jos e intenționat prea scurtă: aplicația nu pornește până n-o înlocuiești)
JWT_SECRET=PUNE_AICI_O_CHEIE_SECRETA

# Opțional (valorile implicite sunt cele de mai jos):
# JWT_ACCESS_TTL_MINUTES=60
# JWT_REFRESH_TTL_DAYS=7
# SSO_MODE=mock                      # mock = SSO simulat (dezvoltare); oidc = SSO real (încă neconfigurat)
# SSO_REDIRECT_URI=http://localhost:8000/v1/auth/sso/callback
