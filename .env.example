# Copiază acest fișier ca ".env" și completează parola ta de PostgreSQL.
# Fișierul .env NU se urcă pe GitHub (este în .gitignore).
DATABASE_URL=postgresql+psycopg://postgres:PAROLA_TA@localhost:5433/db_campus_sports

# Opțional: baza de date folosită doar de teste (trebuie să se termine cu _test).
# Dacă lipsește, se folosește numele din DATABASE_URL + "_test".
# TEST_DATABASE_URL=postgresql+psycopg://postgres:PAROLA_TA@localhost:5433/db_campus_sports_test
